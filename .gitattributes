# 默认：仓库内统一 LF，避免 Windows 检出时把配置改成 CRLF
* text=auto eol=lf

# 部署到 Linux 的配置与脚本，必须是 LF
*.conf   text eol=lf
*.service text eol=lf
*.timer  text eol=lf
*.sh     text eol=lf
*.py     text eol=lf
*.ps1    text eol=crlf
*.md     text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.json   text eol=lf

# 二进制
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.zip binary
*.pem binary
*.key binary
