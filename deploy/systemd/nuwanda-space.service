[Unit]
Description=Nuwanda Space Astro standalone
After=network.target

[Service]
Type=simple
User=nuwanda-web
Group=nuwanda-web
WorkingDirectory=/srv/nuwanda-blog/current
ExecStart=/srv/nuwanda-blog/runtime/node-v24.22.0-linux-x64/bin/node /srv/nuwanda-blog/current/dist/server/entry.mjs
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=4323
Environment=ASTRO_TELEMETRY_DISABLED=1
Restart=on-failure
RestartSec=3
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nuwanda-space
MemoryMax=384M
TasksMax=64

[Install]
WantedBy=multi-user.target
