---
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import '../styles/site.css';
interface Props { title: string; description?: string; noindex?: boolean; shell?: boolean; cover?: boolean }
const { title, description = site.description, noindex = false, shell = true, cover: isCover = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url);
const socialImage = await getImage({ src: site.cover.src, width: 1200, format: 'jpeg' });
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F7F5F0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={site.keywords.join(', ')} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="nuwanda.space" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(socialImage.src, site.url)} />
    <meta property="og:image:width" content={socialImage.attributes.width} />
    <meta property="og:image:height" content={socialImage.attributes.height} />
    <meta property="og:image:alt" content={site.cover.alt} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class:list={[{ 'cover-page': isCover }]}>
    <a class="skip-link" href="#main">跳至主要内容</a>
    {shell && <Header />}
    <slot name="header" />
    <main id="main" tabindex="-1"><slot /></main>
    {shell && <Footer />}
    <slot name="footer" />
  </body>
</html>
