---
import SiteLayout from './SiteLayout.astro';
import BlogNavigation from '../components/BlogNavigation.astro';
import Footer from '../components/Footer.astro';
import type { SectionSlug } from '../data/site';
interface Props { title: string; description: string; active: SectionSlug; noindex?: boolean }
const { title, description, active, noindex = false } = Astro.props;
---
<SiteLayout title={title} description={description} noindex={noindex} shell={false}>
  <BlogNavigation slot="header" active={active} />
  <div class:list={['blog-main', 'container', `module-${active}`]}><slot /></div>
  <Footer slot="footer" />
</SiteLayout>
