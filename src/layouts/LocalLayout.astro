---
interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Nuwanda Space</title>
    <link rel="icon" href="/local-mark.svg" type="image/svg+xml" />
  </head>
  <body>
    <header><a href="/">Nuwanda Space</a><span>本地开发</span></header>
    <main><slot /></main>
    <footer>环境验收页面 · 2026-10-15</footer>
  </body>
</html>
<style is:global>
  :root { color-scheme: light; font-family: system-ui, "Microsoft YaHei", sans-serif; color: #18302a; background: #f5f5ef; }
  body { max-width: 800px; margin: auto; padding: 32px 24px; line-height: 1.8; }
  header { display: flex; justify-content: space-between; border-bottom: 1px solid #c7d0c5; padding-bottom: 16px; }
  a { color: #285d46; text-underline-offset: 4px; }
  main { padding: 40px 0; }
  h1 { font-size: clamp(1.8rem, 5vw, 2.6rem); line-height: 1.3; }
  code { overflow-wrap: anywhere; font-size: .95em; }
  footer { color: #526258; border-top: 1px solid #c7d0c5; padding-top: 16px; }
  button { padding: 8px 16px; font: inherit; cursor: pointer; }
</style>
